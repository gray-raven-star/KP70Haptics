<Window x:Class="KP70Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audio Rumble" Icon="app.ico" Width="1116" Height="800" MinWidth="960" MinHeight="630"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}" FontFamily="Microsoft YaHei UI"
        FontSize="13" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Window.Resources>


        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="21" />
        </Style>
        <Style x:Key="Tag" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Panel}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="21" />
        </Style>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="20,11" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.84" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Text}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryAction" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="{DynamicResource Panel}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
        </Style>
        <Style x:Key="DeleteAction" TargetType="Button" BasedOn="{StaticResource SecondaryAction}">
            <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
        </Style>
        <Style x:Key="DangerAction" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="{DynamicResource DangerFill}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="PresetInput" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputFace" Background="{DynamicResource Inset}" BorderBrush="{DynamicResource Border}"
                                BorderThickness="1" CornerRadius="9" Padding="10,8">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputFace" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MenuChoice" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Choice" Background="Transparent" Padding="10,8" CornerRadius="6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Choice" Property="Background" Value="{DynamicResource Selected}"/></Trigger>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Choice" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Picker" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="39"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource MenuChoice}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="PickerFace" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}"
                                                BorderThickness="1" CornerRadius="9"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PickerFace" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="PickerFace" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="12,0,28,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                            <Path IsHitTestVisible="False" Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource Muted}" StrokeThickness="1.5"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True">
                                <Border Margin="0,4,0,0" Padding="4" CornerRadius="9" Background="{DynamicResource Panel}"
                                        BorderBrush="{DynamicResource Border}" BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Rail" Width="44" Height="24" Padding="3" Background="{DynamicResource Track}" CornerRadius="12">
                            <Ellipse x:Name="Knob" Fill="{DynamicResource Knob}" Width="18" Height="18" HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Rail" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource OnAccent}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Rail" Property="Opacity" Value="0.75" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Mode" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Pill" Background="Transparent" CornerRadius="7" Padding="8,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Selected}" />
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Pill" Property="Opacity" Value="0.44" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="SliderFill" TargetType="RepeatButton">
            <Border Height="4" Background="{DynamicResource Accent}" CornerRadius="2" />
        </ControlTemplate>
        <ControlTemplate x:Key="SliderRail" TargetType="RepeatButton">
            <Border Height="4" Background="{DynamicResource Track}" CornerRadius="2" />
        </ControlTemplate>
        <Style TargetType="Slider">
            <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger></Style.Triggers>
            <Setter Property="Height" Value="27" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="SmallChange" Value="1" />
            <Setter Property="LargeChange" Value="5" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Template="{StaticResource SliderFill}" /></Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Template="{StaticResource SliderRail}" /></Track.IncreaseRepeatButton>
                            <Track.Thumb><Thumb Width="16" Height="16"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{DynamicResource Knob}" Stroke="{DynamicResource Accent}" StrokeThickness="2" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="5" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="2" Background="{DynamicResource Border}" />
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource Accent}" />
                    </Grid>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="{DynamicResource Surface}">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer x:Name="DevicePage" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="31,30,31,22">
                <DockPanel Margin="0,0,0,24">
                    <Button x:Name="RefreshButton" DockPanel.Dock="Right" Style="{StaticResource Action}"
                            Content="刷新设备" Click="RefreshDevices" MinWidth="110" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="AUDIO RUMBLE  /  V2.2" Style="{StaticResource Tag}" />
                        <TextBlock Text="选择手柄" FontSize="32" FontWeight="Bold" Margin="0,5,0,5" />
                        <TextBlock Text="选中设备后，按型号显示可用的触觉设置。" Style="{StaticResource Note}" />
                    </StackPanel>
                </DockPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <TextBlock x:Name="DeviceMessage" Text="正在查找北通手柄…" Style="{StaticResource Note}" />
                </Border>
                <ItemsControl x:Name="DeviceList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Action}" Content="进入设置"
                                            Click="OpenDevice" MinWidth="110" VerticalAlignment="Center" Margin="14,0,0,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="21" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource Note}" Margin="0,5,0,2" />
                                        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Accent}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="31,25,31,20">
                <DockPanel LastChildFill="True" Margin="0,0,0,19">
                    <Border DockPanel.Dock="Right" VerticalAlignment="Center" Background="{DynamicResource Hover}" CornerRadius="12" Padding="12,6">
                        <TextBlock x:Name="StatusPill" Text="待启动" Foreground="{DynamicResource Accent}" />
                    </Border>
                    <Button x:Name="TuneButton" DockPanel.Dock="Right" Style="{StaticResource Action}" Content="进阶设置"
                            Click="EditChannels" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BackButton" Style="{StaticResource Action}" Content="返回设备" Click="BackToDevices"
                                VerticalAlignment="Center" Margin="0,0,14,0" />
                        <StackPanel><TextBlock x:Name="DeviceTitle" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="AUDIO RUMBLE  /  V2.2" Style="{StaticResource Tag}" /></StackPanel>
                    </StackPanel>
                </DockPanel>
                <Border Background="{DynamicResource Hero}" CornerRadius="18" Padding="22,18" BorderThickness="1" BorderBrush="{DynamicResource Border}" Margin="0,0,0,16">

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="255"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="实时音频触觉" FontSize="26" FontWeight="Bold" />
                            <TextBlock Text="跟随 Windows 默认播放设备的声音" Style="{StaticResource Note}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <DockPanel><TextBlock x:Name="InputValue" DockPanel.Dock="Right" Text="0%" Foreground="{DynamicResource Accent}" /><TextBlock Text="音频输入" Style="{StaticResource Note}" /></DockPanel>
                            <ProgressBar x:Name="InputMeter" Margin="0,9,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
                <DockPanel Margin="0,0,0,15" LastChildFill="False">
                    <TextBlock Text="预设" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox x:Name="PresetList" Style="{StaticResource Picker}" DisplayMemberPath="Name" SelectionChanged="PresetChanged"
                              Width="180" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="SavePresetButton" Content="保存" Click="SavePreset" Style="{StaticResource SecondaryAction}" Margin="0,0,6,0"/>
                    <Button Content="另存为" Click="AddPreset" Style="{StaticResource Action}" Margin="0,0,6,0"/>
                    <Button x:Name="RenamePresetButton" Content="重命名" Click="RenamePreset" Style="{StaticResource SecondaryAction}" Margin="0,0,6,0"/>
                    <Button x:Name="DeletePresetButton" Content="删除" Click="DeletePreset" Style="{StaticResource DeleteAction}"/>
                </DockPanel>
                <UniformGrid x:Name="PanelCards" Rows="1" Margin="-6,0,-6,16">
                    <Border x:Name="ShoulderCard" Style="{StaticResource Card}" Margin="6,0">
                        <StackPanel>
                            <DockPanel><CheckBox x:Name="ShoulderOn" DockPanel.Dock="Right" Style="{StaticResource Switch}" AutomationProperties.Name="肩键开关" Checked="SettingsChanged" Unchecked="SettingsChanged" /><TextBlock Text="肩键" FontSize="21" FontWeight="SemiBold" /></DockPanel>
                            <DockPanel Margin="0,13,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=ShoulderGain, StringFormat={}{0:0}%}" Foreground="{DynamicResource Accent}"/><TextBlock Text="输出强度"/></DockPanel>
                            <Slider x:Name="ShoulderGain" ValueChanged="SettingsChanged" AutomationProperties.Name="肩键强度" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=ShoulderSensitivity, StringFormat={}{0:0}%}" Foreground="{DynamicResource Accent}"/><TextBlock Text="输入灵敏度"/></DockPanel>
                                    <Slider x:Name="ShoulderSensitivity" Minimum="10" Maximum="250" ValueChanged="SettingsChanged" AutomationProperties.Name="肩键灵敏度" ToolTip="数值越高，越容易感知较轻的声音。" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=ShoulderThreshold, StringFormat={}{0:0}%}" Foreground="{DynamicResource Accent}"/><TextBlock Text="触发阈值"/></DockPanel>
                                    <Slider x:Name="ShoulderThreshold" Minimum="0" Maximum="100" ValueChanged="SettingsChanged" AutomationProperties.Name="肩键触发阈值" ToolTip="肩键的声音信号达到这个值才会震动。提高可减少背景声触发。" />
                                </StackPanel>
                            </Grid>
                            <DockPanel Margin="0,13,0,0">
                                <CheckBox x:Name="ShoulderPress" DockPanel.Dock="Right" Style="{StaticResource Switch}" AutomationProperties.Name="肩键仅按住时震动" Checked="SettingsChanged" Unchecked="SettingsChanged" />
                                <TextBlock Text="仅按住时震动" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="左 / 右输出" Style="{StaticResource Note}" Margin="0,20,0,6"/>
                            <ProgressBar x:Name="ShoulderL" /><ProgressBar x:Name="ShoulderR" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="6,0">
                        <StackPanel>
                            <DockPanel><CheckBox x:Name="GripOn" DockPanel.Dock="Right" Style="{StaticResource Switch}" AutomationProperties.Name="握把音频开关" Checked="SettingsChanged" Unchecked="SettingsChanged" /><TextBlock Text="握把" FontSize="21" FontWeight="SemiBold" /></DockPanel>
                            <Border Background="{DynamicResource Inset}" CornerRadius="9" Padding="3" Margin="0,9,0,8">
                                <UniformGrid Rows="1">
                                    <RadioButton x:Name="GripNative" GroupName="GripMode" Style="{StaticResource Mode}" Content="原生" Checked="SettingsChanged" />
                                    <RadioButton x:Name="GripAudio" GroupName="GripMode" Style="{StaticResource Mode}" Content="音频" Checked="SettingsChanged" />
                                </UniformGrid>
                            </Border>
                            <TextBlock x:Name="GripHint" Text="原生：交给游戏。音频：本软件接管。" Style="{StaticResource Note}" MinHeight="43" />
                            <StackPanel x:Name="GripTuning">
                            <DockPanel Margin="0,8,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=GripGain, StringFormat={}{0:0}%}" Foreground="{DynamicResource Accent}"/><TextBlock Text="输出强度"/></DockPanel>
                            <Slider x:Name="GripGain" ValueChanged="SettingsChanged" AutomationProperties.Name="握把音频强度" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=GripSensitivity, StringFormat={}{0:0}%}" Foreground="{DynamicResource Accent}"/><TextBlock Text="输入灵敏度"/></DockPanel>
                                    <Slider x:Name="GripSensitivity" Minimum="10" Maximum="250" ValueChanged="SettingsChanged" AutomationProperties.Name="握把灵敏度" ToolTip="数值越高，越容易感知较轻的声音。" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=GripThreshold, StringFormat={}{0:0}%}" Foreground="{DynamicResource Accent}"/><TextBlock Text="触发阈值"/></DockPanel>
                                    <Slider x:Name="GripThreshold" Minimum="0" Maximum="100" ValueChanged="SettingsChanged" AutomationProperties.Name="握把触发阈值" ToolTip="握把跟随低频声音。提高阈值可减少微弱低频触发。" />
                                </StackPanel>
                            </Grid>
                            </StackPanel>
                            <ProgressBar x:Name="GripL" Margin="0,10,0,0" /><ProgressBar x:Name="GripR" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="TriggerCard" Style="{StaticResource Card}" Margin="6,0">
                        <StackPanel>
                            <DockPanel><CheckBox x:Name="TriggerOn" DockPanel.Dock="Right" Style="{StaticResource Switch}" AutomationProperties.Name="扳机开关" Checked="SettingsChanged" Unchecked="SettingsChanged" /><TextBlock Text="扳机" FontSize="21" FontWeight="SemiBold" /></DockPanel>
                            <StackPanel x:Name="ForceBase">
                                <DockPanel Visibility="Collapsed" Margin="0,8,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=TriggerBase, StringFormat={}{0:0}}" Foreground="{DynamicResource Accent}"/><TextBlock Text="基础阻力"/></DockPanel>
                                <Slider x:Name="TriggerBase" Visibility="Collapsed" Maximum="36" ValueChanged="SettingsChanged" AutomationProperties.Name="基础阻力" ToolTip="平时扣扳机的阻力。设为 0 可以只保留声音触发的震动。" />
                            </StackPanel>
                            <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=TriggerKick, StringFormat={}{0:0}}" Foreground="{DynamicResource Accent}"/><TextBlock x:Name="TriggerStrengthLabel" Text="反冲强度"/></DockPanel>
                            <Slider x:Name="TriggerKick" Maximum="60" ValueChanged="SettingsChanged" AutomationProperties.Name="扳机振动强度" ToolTip="调节音频引发的扳机振动力度。" />
                            <StackPanel x:Name="ForceFrequencyAndStart">
                                <DockPanel Visibility="Collapsed"><TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=TriggerFrequency, StringFormat={}{0:0}}" Foreground="{DynamicResource Accent}"/><TextBlock Text="震动频率档"/></DockPanel>
                                <Slider x:Name="TriggerFrequency" Visibility="Collapsed" Minimum="1" Maximum="63" ValueChanged="SettingsChanged" AutomationProperties.Name="震动频率档" ToolTip="改变反冲的震动节奏。数值为手柄档位。" />
                                <DockPanel Visibility="Collapsed"><TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=TriggerStart, StringFormat={}{0:0}}" Foreground="{DynamicResource Accent}"/><TextBlock Text="阻力起点"/></DockPanel>
                                <Slider x:Name="TriggerStart" Visibility="Collapsed" Maximum="40" ValueChanged="SettingsChanged" AutomationProperties.Name="阻力起点" ToolTip="设定扣到哪里开始感到阻力。数值越大，生效位置越靠后。" />
                            </StackPanel>
                            <DockPanel x:Name="TriggerPressRow" Margin="0,8,0,0">
                                <CheckBox x:Name="TriggerPress" DockPanel.Dock="Right" Style="{StaticResource Switch}" AutomationProperties.Name="扳机仅按住时震动" Checked="SettingsChanged" Unchecked="SettingsChanged" />
                                <TextBlock Text="仅按住时震动" VerticalAlignment="Center" />
                            </DockPanel>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=TriggerSensitivity, StringFormat={}{0:0}%}" Foreground="{DynamicResource Accent}"/><TextBlock Text="输入灵敏度"/></DockPanel>
                                    <Slider x:Name="TriggerSensitivity" Minimum="10" Maximum="250" ValueChanged="SettingsChanged" AutomationProperties.Name="扳机灵敏度" ToolTip="数值越高，越容易感知较轻的声音。" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=TriggerThreshold, StringFormat={}{0:0}%}" Foreground="{DynamicResource Accent}"/><TextBlock Text="触发阈值"/></DockPanel>
                                    <Slider x:Name="TriggerThreshold" Minimum="1" Maximum="100" ValueChanged="SettingsChanged" AutomationProperties.Name="扳机反冲阈值" ToolTip="扣住扳机时，处理后的声音达到这个值才触发短震。提高可减少误触发。" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="TriggerStatus" Text="左 待机  ·  右 待机" Style="{StaticResource Note}" Margin="0,5,0,5" />
                            <ProgressBar x:Name="TriggerL" /><ProgressBar x:Name="TriggerR" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <Border x:Name="ResponseCard" Style="{StaticResource Card}" Padding="18,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="175"/><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="声音响应" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="3"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=Suppression, StringFormat={}{0:0}%}" Foreground="{DynamicResource Accent}"/><TextBlock Text="持续声抑制"/></DockPanel><Slider x:Name="Suppression" Maximum="150" ValueChanged="SettingsChanged" AutomationProperties.Name="持续声抑制" /></StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border x:Name="SettingsFooter" Visibility="Collapsed" Grid.Row="1" Background="{DynamicResource Footer}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Border}" Padding="30,12">
            <DockPanel>
                <ComboBox x:Name="ThemePicker" Style="{StaticResource Picker}" DockPanel.Dock="Right" Width="112" VerticalAlignment="Center"
                          Margin="12,0,0,0" AutomationProperties.Name="主题" SelectionChanged="ThemeChanged">
                    <ComboBoxItem Content="红白" Tag="red"/>
                    <ComboBoxItem Content="深色" Tag="dark"/>
                    <ComboBoxItem Content="浅色" Tag="light"/>
                </ComboBox>
                <Button x:Name="RunButton" DockPanel.Dock="Right" Style="{StaticResource Action}" Content="启动音频震动" Click="ToggleRun" MinWidth="116" Margin="16,0,0,0" />
                <TextBlock x:Name="StatusLine" Text="连接鲲鹏 70 后启动。关闭北通智控可避免它覆盖效果。" Style="{StaticResource Note}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
